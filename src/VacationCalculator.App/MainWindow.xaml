<Window x:Class="VacationCalculator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VacationCalculator.App.ViewModels"
        xmlns:svc="clr-namespace:VacationCalculator.App.Services"
        xmlns:beh="clr-namespace:VacationCalculator.App.Behaviors"
        xmlns:ctl="clr-namespace:VacationCalculator.App.Controls"
        xmlns:core="clr-namespace:VacationCalculator.Core;assembly=VacationCalculator.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Vacation Calculator"
        Width="1120" Height="716" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <svc:DateTextConverter x:Key="DateText" />
        <svc:AddNumberConverter x:Key="AddNumber" />

        <!-- Messages of the last user action; hidden while empty. Shown in both tabs, so a refusal is never out of sight. -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Calendar cells. Light templates on purpose: 12 months of about 50 cells are rebuilt on every refresh. -->
        <DataTemplate DataType="{x:Type vm:WeekNumberCell}">
            <TextBlock Text="{Binding Text}" Height="20" Margin="1" FontSize="9" Padding="0,5,0,0" TextAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DayCell}">
            <Grid x:Name="Root" Height="20" Margin="1" Background="Transparent" ToolTip="{Binding Tooltip}">
                <Border x:Name="Bg" CornerRadius="3" />
                <Polygon x:Name="Half" Points="1,0 1,1 0,1" Stretch="Fill" Visibility="Collapsed" />
                <Border x:Name="TodayRing" CornerRadius="3" />
                <Border x:Name="Ring" CornerRadius="3" />
                <Border x:Name="DragMark" CornerRadius="3" BorderThickness="2" Visibility="Collapsed" />
                <TextBlock x:Name="Num" Text="{Binding Text}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Fill}" Value="Plain">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CalDayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fill}" Value="Weekend">
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fill}" Value="Holiday">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CalHolidayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fill}" Value="Vacation">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fill}" Value="Feriefri">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FeriefriBrush}" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                </DataTrigger>
                <!-- Half days: soft fill with a solid triangle in the lower right corner, number in the upper left -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Fill}" Value="Vacation" />
                        <Condition Binding="{Binding IsHalf}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="Half" Property="Fill" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Half" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter TargetName="Num" Property="HorizontalAlignment" Value="Left" />
                    <Setter TargetName="Num" Property="VerticalAlignment" Value="Top" />
                    <Setter TargetName="Num" Property="Margin" Value="3,1,0,0" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Fill}" Value="Feriefri" />
                        <Condition Binding="{Binding IsHalf}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FeriefriSoftBrush}" />
                    <Setter TargetName="Half" Property="Fill" Value="{DynamicResource FeriefriBrush}" />
                    <Setter TargetName="Half" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter TargetName="Num" Property="HorizontalAlignment" Value="Left" />
                    <Setter TargetName="Num" Property="VerticalAlignment" Value="Top" />
                    <Setter TargetName="Num" Property="Margin" Value="3,1,0,0" />
                </MultiDataTrigger>
                <!-- Past days: slightly dimmed fill, muted number on plain days -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Fill}" Value="Plain" />
                        <Condition Binding="{Binding IsPast}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                    <Setter TargetName="Bg" Property="Opacity" Value="0.65" />
                    <Setter TargetName="Half" Property="Opacity" Value="0.65" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="TodayRing" Property="BorderThickness" Value="2" />
                    <Setter TargetName="TodayRing" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                    <Setter TargetName="Num" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <!-- A conflict has its own ring; on today it sits just inside the today ring so both stay visible -->
                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                    <Setter TargetName="Ring" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    <Setter TargetName="Num" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsConflict}" Value="True" />
                        <Condition Binding="{Binding IsToday}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Ring" Property="Margin" Value="2" />
                    <Setter TargetName="Ring" Property="CornerRadius" Value="2" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsBookable}" Value="True">
                    <Setter TargetName="Root" Property="Cursor" Value="Hand" />
                </DataTrigger>
                <!-- Range being dragged: soft fill and a solid border in the colour of the type being booked -->
                <DataTrigger Binding="{Binding Drag}" Value="Vacation">
                    <Setter TargetName="DragMark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DragMark" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="DragMark" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Drag}" Value="Feriefri">
                    <Setter TargetName="DragMark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DragMark" Property="Background" Value="{DynamicResource FeriefriSoftBrush}" />
                    <Setter TargetName="DragMark" Property="BorderBrush" Value="{DynamicResource FeriefriBrush}" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlank}" Value="True">
                    <Setter TargetName="Root" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MonthView}">
            <Border Style="{StaticResource Card}" Padding="8,6,8,8">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,4" />
                    <UniformGrid Columns="8" Margin="1,0">
                        <TextBlock />
                        <TextBlock Text="M" /><TextBlock Text="T" /><TextBlock Text="W" /><TextBlock Text="T" />
                        <TextBlock Text="F" /><TextBlock Text="S" /><TextBlock Text="S" />
                        <UniformGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </UniformGrid.Resources>
                    </UniformGrid>
                    <ItemsControl ItemsSource="{Binding Cells}" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Legend swatch: a small square with the same look as the day cells -->
        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: app name, year, settings, public holidays and the theme switch -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,22,20,18">
                <TextBlock DockPanel.Dock="Top" Text="Vacation Calculator" FontFamily="{StaticResource HeadingFont}"
                           FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" />

                <!-- Theme switch at the bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
                    <UniformGrid Rows="1">
                        <RadioButton GroupName="Theme" Content="Light" Style="{StaticResource SegmentButton}"
                                     IsChecked="{Binding IsLightTheme}" />
                        <RadioButton GroupName="Theme" Content="Dark" Style="{StaticResource SegmentButton}"
                                     IsChecked="{Binding IsDarkTheme}" />
                        <RadioButton GroupName="Theme" Content="System" Style="{StaticResource SegmentButton}"
                                     IsChecked="{Binding IsSystemTheme}" />
                    </UniformGrid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="0,0,6,0">
                <!-- Year navigation -->
                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="Year" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="◀" Command="{Binding PreviousYearCommand}" ToolTip="Previous year" />
                        <Button DockPanel.Dock="Right" Content="▶" Command="{Binding NextYearCommand}" ToolTip="Next year" />
                        <TextBlock Text="{Binding SelectedYear}" FontFamily="{StaticResource HeadingFont}" FontSize="22"
                                   FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                    </DockPanel>
                    <Button Content="This year" Command="{Binding CurrentYearCommand}" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Employment settings -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                    <TextBlock Text="Employment" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Employed since" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding EmployedSince}" />
                    <TextBlock Text="Leave empty if you were employed before the holiday years shown." TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,12" />
                    <TextBlock Text="First holiday year tracked" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FirstTrackedChoices}" SelectedItem="{Binding FirstTrackedHolidayYear}" />
                    <TextBlock Text="Days transferred into it" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding OpeningBalanceDays, UpdateSourceTrigger=PropertyChanged, Delay=400}" beh:CommitOnEnter.IsEnabled="True" />
                    <TextBlock Text="Unused days you brought into that year. Leave at 0 if none." TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,12" />

                    <!-- Settings for the holiday year whose deadline is in the selected calendar year -->
                    <TextBlock Text="{Binding DeadlineSettingsTitle}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,6" />

                    <StackPanel>
                        <TextBlock Text="Days that can be transferred" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding TransferLimitDays, UpdateSourceTrigger=PropertyChanged, Delay=400}" beh:CommitOnEnter.IsEnabled="True" />
                        <DockPanel Margin="0,3,0,0">
                            <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetTransferLimitCommand}"
                                    Style="{StaticResource LinkButton}" Visibility="{Binding TransferLimitIsOwn, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding TransferLimitSource}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        </DockPanel>
                        <TextBlock Text="5 by the Holiday Act; more with a personal agreement; 0 = no transfer." TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,10" />
                    </StackPanel>

                    <TextBlock Text="Other unused days paid out" Style="{StaticResource FieldLabel}" />
                    <UniformGrid Rows="1">
                        <RadioButton GroupName="Payout" Content="None" Style="{StaticResource SegmentButton}" IsChecked="{Binding PayoutNone}" />
                        <RadioButton GroupName="Payout" Content="Some" Style="{StaticResource SegmentButton}" IsChecked="{Binding PayoutSome}" />
                        <RadioButton GroupName="Payout" Content="All" Style="{StaticResource SegmentButton}" IsChecked="{Binding PayoutAll}" />
                    </UniformGrid>
                    <TextBox Text="{Binding PayoutDays, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,6,4,0" beh:CommitOnEnter.IsEnabled="True">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PayoutSome}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <DockPanel Margin="0,3,0,0">
                        <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetPayoutCommand}"
                                Style="{StaticResource LinkButton}" Visibility="{Binding PayoutIsOwn, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding PayoutSource}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    </DockPanel>
                    <TextBlock Text="Covers days beyond the 5th week. 5th-week days are always paid out unless transferred."
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <!-- Public holidays: the whole list scrolls with the sidebar -->
                <StackPanel>
                    <TextBlock Text="Public holidays" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"
                               Text="Danish public holidays are included automatically. Add extra days off, such as Grundlovsdag or company days. Weekends and holidays don't count as vacation days." />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddHolidayCommand}" Margin="8,0,0,0" />
                        <DatePicker SelectedDate="{Binding NewHoliday}" />
                    </DockPanel>

                    <TextBlock Text="Your extra days off" FontWeight="SemiBold" Margin="0,2,0,4" />
                    <TextBlock Text="None added." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoManualHolidays}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ManualHolidayRows}" Margin="0,0,0,10" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}"
                                            Padding="6,0" MinWidth="0" MinHeight="0" ToolTip="{Binding RemoveTooltip}"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveHolidayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Date}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Date, Converter={StaticResource DateText}, ConverterParameter=Weekday}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasName}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Danish public holidays" FontWeight="SemiBold" Margin="0,2,0,4" />
                    <ItemsControl ItemsSource="{Binding AutomaticHolidayRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Date, Converter={StaticResource DateText}, ConverterParameter=Weekday}"
                                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main content: summary and status on top; below them the Calendar | List tabs. -->
        <Grid Grid.Column="1" Margin="32,12,32,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- At the smallest window sizes the content scrolls as one area; its height is the viewport but never below MinHeight. -->
            <ScrollViewer x:Name="MainScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <!-- Never smaller than the heading, summary and banner plus room for the tab header, booking form and a few list rows. -->
            <Grid Height="{Binding ViewportHeight, ElementName=MainScroll}"
                  MinHeight="{Binding ActualHeight, ElementName=TopArea, Converter={StaticResource AddNumber}, ConverterParameter=290}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="TopArea" Grid.Row="0">
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="{Binding SummaryToggleText}" Command="{Binding ToggleSummaryCommand}"
                        Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="12,0,0,0"
                        ToolTip="Show or hide the figures and holiday-year tables above the calendar" />
                <!-- One line at every width: the heading scales down when it does not fit next to the toggle -->
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding HolidayYearTitle}" TextWrapping="NoWrap"
                               FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="SemiBold" />
                </Viewbox>
            </DockPanel>

            <StackPanel Visibility="{Binding IsSummaryExpanded, Converter={StaticResource BoolToVisibility}}">
                <!-- Summary figures for the holiday year that expires on 31 December -->
                <UniformGrid Rows="1" Margin="0,0,0,8">
                    <Border Style="{StaticResource Card}" Padding="16,6" Margin="0,0,10,0">
                        <DockPanel>
                            <!-- The note sits next to the value when there is room, otherwise under it -->
                            <WrapPanel DockPanel.Dock="Bottom">
                                <TextBlock Text="{Binding Status.HolidayYear.EarnedSoFar, StringFormat={}{0:0.##}}" Style="{StaticResource StatValue}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding EarnableNote}" Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                           TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock Text="Earned so far" Style="{StaticResource StatLabel}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,6" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status.HolidayYear.UsedDays, StringFormat={}{0:0.##}}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Used" Style="{StaticResource StatLabel}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,6" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status.HolidayYear.BookedAheadDays, StringFormat={}{0:0.##}}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Booked ahead" Style="{StaticResource StatLabel}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,6" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status.UnbookedDays, StringFormat={}{0:0.##}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnbookedSign}" Value="1">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UnbookedSign}" Value="-1">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Not yet booked" Style="{StaticResource StatLabel}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status.WorkingDaysLeft, StringFormat={}{0:0.##}}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="Working days left" Style="{StaticResource StatLabel}" />
                        </DockPanel>
                    </Border>
                </UniformGrid>

                <!-- Holiday years open around this calendar year -->
                <Border Style="{StaticResource Card}" Padding="16,6" Margin="0,0,0,8">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="A" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="B" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="C" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="D" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="E" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="F" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="G" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="H" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Year" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="Earned&#10;so far" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2" Text="Transferred in" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="3" Text="Used" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="4" Text="Booked&#10;ahead" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="5" Text="Remaining" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="6" Text="To next year" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="7" Text="Use by" Style="{StaticResource FieldLabel}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding HolidayYearRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="A" Width="Auto" />
                                                <ColumnDefinition SharedSizeGroup="B" Width="Auto" />
                                                <ColumnDefinition SharedSizeGroup="C" Width="Auto" />
                                                <ColumnDefinition SharedSizeGroup="D" Width="Auto" />
                                                <ColumnDefinition SharedSizeGroup="E" Width="Auto" />
                                                <ColumnDefinition SharedSizeGroup="F" Width="Auto" />
                                                <ColumnDefinition SharedSizeGroup="G" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="H" Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Earned}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding TransferredIn, StringFormat={}{0:0.##;;–}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowProjected}" Value="True">
                                                                <Setter Property="Text" Value="{Binding TransferredIn, StringFormat={}{0:0.##} (projected)}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                                <Setter Property="ToolTip" Value="{Binding ProjectedTooltip}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Text="{Binding Used, StringFormat={}{0:0.##}}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="4" Text="{Binding BookedAhead, StringFormat={}{0:0.##}}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="5" Text="{Binding Remaining, StringFormat={}{0:0.##}}" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RemainingSign}" Value="-1">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="6" Text="{Binding TransferredOut, StringFormat={}{0:0.##;;–}}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="7" Text="{Binding Deadline, StringFormat=d}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Note}" FontSize="11" Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Note}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NoteIsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Feriefri days of the same holiday years, one compact line each -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,5,0,0">
                        <ItemsControl ItemsSource="{Binding FeriefriRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition SharedSizeGroup="FA" Width="Auto" />
                                            <ColumnDefinition SharedSizeGroup="FB" Width="Auto" />
                                            <ColumnDefinition SharedSizeGroup="FC" Width="Auto" />
                                            <ColumnDefinition SharedSizeGroup="FD" Width="Auto" />
                                            <ColumnDefinition SharedSizeGroup="FE" Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Margin="0,0,16,0" FontWeight="SemiBold">
                                            <Run Text="Feriefri" Foreground="{DynamicResource FeriefriBrush}" /><Run Text=" " /><Run Text="{Binding Name, Mode=OneWay}" />
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" ToolTip="{Binding AllowanceTooltip}">
                                            <TextBox Text="{Binding AllowanceDays, StringFormat={}{0:0.##}}" Width="42" Height="22" MinHeight="0"
                                                     Padding="2,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                     beh:CommitOnEnter.IsEnabled="True"
                                                     ToolTip="Feriefri days this holiday year provides (0 to 20). Press Enter or Tab to save." />
                                            <TextBlock Text="{Binding AllowanceSource, StringFormat=' ({0})'}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <Button Content="Reset" Command="{Binding ResetAllowanceCommand}" Style="{StaticResource LinkButton}"
                                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding AllowanceIsOwn, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Used, StringFormat={}{0:0.##} used}" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding BookedAhead, StringFormat={}{0:0.##} booked ahead}" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding Remaining, StringFormat={}{0:0.##} remaining}" Margin="0,0,16,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RemainingSign}" Value="-1">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <!-- The note follows the figures on the same line when there is room, otherwise it wraps onto its own line -->
                                    <TextBlock Text="{Binding Note}" ToolTip="{Binding Note}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource FeriefriBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NoteIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- Status banner: colour follows how urgent the situation is -->
            <Border CornerRadius="10" Padding="18,7" Margin="0,0,0,8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BannerInfoBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BannerInfoBorder}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource BannerInfoForeground}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.Status}" Value="{x:Static core:BalanceStatus.AllPlanned}">
                                <Setter Property="Background" Value="{DynamicResource BannerSuccessBackground}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BannerSuccessBorder}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BannerSuccessForeground}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status.Status}" Value="{x:Static core:BalanceStatus.DaysWillBeLost}">
                                <Setter Property="Background" Value="{DynamicResource BannerDangerBackground}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BannerDangerBorder}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BannerDangerForeground}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status.Status}" Value="{x:Static core:BalanceStatus.OverBooked}">
                                <Setter Property="Background" Value="{DynamicResource BannerWarningBackground}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BannerWarningBorder}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BannerWarningForeground}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status.Status}" Value="{x:Static core:BalanceStatus.Expired}">
                                <Setter Property="Background" Value="{DynamicResource BannerNeutralBackground}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BannerNeutralBorder}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BannerNeutralForeground}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="14" />
                    <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!-- Empty: keeps its space on the Calendar tab (days must not move under the pointer), collapses on the List tab -->
                                    <DataTrigger Binding="{Binding HasStatusDetail}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasStatusDetail}" Value="False" />
                                            <Condition Binding="{Binding IsListTab}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding FeriefriBanner}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFeriefriBanner}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasFeriefriBanner}" Value="False" />
                                            <Condition Binding="{Binding IsListTab}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Tabs: Calendar (default) and List -->
            <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <UniformGrid DockPanel.Dock="Left" Rows="1" Width="190">
                    <RadioButton GroupName="MainTab" Content="Calendar" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsCalendarTab}" />
                    <RadioButton GroupName="MainTab" Content="List" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsListTab}" />
                </UniformGrid>
                <!-- On the List tab the same row carries the booking form's type choice and working-day preview -->
                <DockPanel Margin="16,0,0,0">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <UniformGrid DockPanel.Dock="Right" Rows="1" Width="190" VerticalAlignment="Center">
                        <RadioButton GroupName="BookType" Content="Vacation" Style="{StaticResource SegmentButton}" IsChecked="{Binding BookVacation}" />
                        <RadioButton GroupName="BookType" Content="Feriefri" Style="{StaticResource SegmentButton}" IsChecked="{Binding BookFeriefri}" />
                    </UniformGrid>
                    <TextBlock Text="{Binding NewEntryPreview}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                </DockPanel>
            </DockPanel>

            <!-- Calendar tab: the year as 12 month cards; clicks and drags on the days book (CalendarBooking behaviour) -->
            <DockPanel Grid.Row="1">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListTab}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <StackPanel DockPanel.Dock="Bottom" Margin="2,6,0,0">
                <TextBlock Style="{StaticResource LegendLabel}" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="Left-click: vacation · Right-click: Feriefri · Click again for half day, then remove · Drag or Shift+click for a range" />
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Vacation" Style="{StaticResource LegendLabel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource FeriefriBrush}" />
                        <TextBlock Text="Feriefri" Style="{StaticResource LegendLabel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource AccentSoftBrush}">
                            <Polygon Points="1,0 1,1 0,1" Stretch="Fill" Fill="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="Half day" Style="{StaticResource LegendLabel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource CalHolidayBrush}" />
                        <TextBlock Text="Public holiday" Style="{StaticResource LegendLabel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Border Style="{StaticResource LegendSwatch}" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" />
                        <TextBlock Text="Weekend" Style="{StaticResource LegendLabel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource CalDayBrush}"
                                BorderBrush="{DynamicResource TextBrush}" BorderThickness="2" />
                        <TextBlock Text="Today" Style="{StaticResource LegendLabel}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource LegendSwatch}" Background="{DynamicResource CalHolidayBrush}"
                                BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1.5" />
                        <TextBlock Text="Booked on a day off (not counted)" Style="{StaticResource LegendLabel}" />
                    </StackPanel>
                </WrapPanel>
                </StackPanel>

                <!-- Messages of calendar clicks sit below the cards, so showing or hiding one never moves the days under the pointer -->
                <!-- MinHeight reserves two lines so a message appearing or wrapping never resizes the scroll area (which would shift the days) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" MinHeight="36">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource InfoText}" Margin="0,0,0,2" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              beh:ScrollChaining.IsEnabled="True"
                              beh:CalendarBooking.IsEnabled="True"
                              beh:CalendarBooking.GestureCommand="{Binding CalendarGestureCommand}"
                              beh:CalendarBooking.PreviewCommand="{Binding CalendarPreviewCommand}">
                    <ItemsControl ItemsSource="{Binding CalendarMonths}" Focusable="False" IsTabStop="False" Margin="0,0,6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctl:AdaptiveUniformGrid MinItemWidth="172" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- List tab: vacation entries -->
            <Border Grid.Row="1" Padding="16,6">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding NewStart}" Width="140" DisplayDateEnd="9998-12-31" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="To" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding NewEnd}" Width="140" DisplayDateEnd="9998-12-31" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                        </StackPanel>
                        <CheckBox Content="Half day" IsChecked="{Binding IsHalfDay}" IsEnabled="{Binding CanBookHalfDay}"
                                  VerticalAlignment="Bottom" Margin="0,0,14,6" />
                        <Button Content="{Binding AddButtonText}" Command="{Binding AddEntryCommand}" IsDefault="True"
                                VerticalAlignment="Bottom" Style="{StaticResource PrimaryButton}" />
                    </WrapPanel>

                    <!-- Preview and validation message for the form, under it so the form layout stays stable -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                        <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource InfoText}" />
                        <DockPanel Margin="0,0,0,8">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConflictNote}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <Button DockPanel.Dock="Right" Content="Remove these days" Command="{Binding RemoveConflictDaysCommand}"
                                    Style="{StaticResource LinkButton}" VerticalAlignment="Top" Margin="12,0,0,0"
                                    ToolTip="Deletes these stored days. Your balances don't change; they were not counted." />
                            <TextBlock Text="{Binding ConflictNote}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                              RowHeight="26" MinHeight="112" CanUserResizeRows="False" SelectionMode="Single"
                              beh:ScrollChaining.IsEnabled="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPast}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="From" Binding="{Binding Period.Start, StringFormat=d}" Width="110" />
                            <DataGridTextColumn Header="To" Binding="{Binding Period.End, StringFormat=d}" Width="110" />
                            <DataGridTemplateColumn Header="Days" Width="80" SortMemberPath="Period.Amount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Period.Amount, StringFormat={}{0:0.##}}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNotCounted}" Value="True">
                                                            <Setter Property="ToolTip" Value="This period is only on public holidays, so it is not counted." />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Type" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                        <TextBlock Text="Vacation" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFeriefri}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border CornerRadius="9" Padding="9,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource FeriefriSoftBrush}">
                                            <TextBlock Text="Feriefri" FontSize="11" Foreground="{DynamicResource FeriefriBrush}" />
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFeriefri}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Description" Width="*" SortMemberPath="Period.Description">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Period.Description, Mode=OneWay}" />
                                            <Run Text="{Binding NotCountedSuffix, Mode=OneWay}" FontSize="11" FontStyle="Italic"
                                                 Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Padding="10,0" MinHeight="0" Margin="0,1" VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            </Grid>
            </Grid>
            </ScrollViewer>

            <!-- Footer: data location (validation messages are shown under the vacation form) -->
            <TextBlock Grid.Row="1" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                       Text="{Binding DataPath, StringFormat=Saved to {0}}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DataPath}" />
        </Grid>
    </Grid>
</Window>
